+    def _process_mxfp8_moe_weights_sm120(self, layer: Module, quantize: bool) -> None:
+        # The SM120 grouped dot_scaled kernel consumes the canonical layout
+        # (w [E, N, K] e4m3, scale [E, N, K // 32] UE8M0), so serialized
+        # checkpoints and hot-reloaded weights need no transform. This keeps
+        # repeated post-processing after weight updates idempotent.
+        if quantize:
+            for weight_param, scale_name in [
+                (layer.w13_weight, "w13_weight_scale_inv"),
+                (layer.w2_weight, "w2_weight_scale_inv"),
+            ]:
+                weight = weight_param.data.contiguous()
+                num_experts, n, k = weight.shape
+                qweight, scale = mxfp8_group_quantize(weight.view(-1, k))
+                weight_param.data = qweight.view(num_experts, n, k)
+                scale_param = getattr(layer, scale_name)
+                scale_param.data = scale.view(num_experts, n, k // 32)
+
+        for name in [
+            "w13_weight",
+            "w2_weight",
+            "w13_weight_scale_inv",
+            "w2_weight_scale_inv",
+        ]:
+            getattr(layer, name).requires_grad_(False)
+        layer.w13_weight_scale_inv.format_ue8m0 = True
+        layer.w2_weight_scale_inv.format_ue8m0 = True
+        layer.w13_input_scale = None
+        layer.w2_input_scale = None
+
     def process_weights_after_loading(self, layer: Module) -> None:
         if _is_hip and _use_hip_int4:
             self.process_weights_hip_int4(layer)
