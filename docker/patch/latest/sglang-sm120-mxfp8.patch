index 000000000..674b73618
--- /dev/null
+++ b/python/sglang/srt/layers/moe/moe_runner/triton_utils/mxfp8_moe_sm120.py
@@ -0,0 +1,155 @@
+"""Native MXFP8 W8A8 (1x32 block, UE8M0 scale) MoE for NVIDIA SM120/SM121.
+
+None of the NVIDIA MXFP8 MoE backends (cutlass ``es_sm100_*``, FlashInfer
+TRT-LLM, DeepGEMM) run on consumer Blackwell. This path reuses the grouped
+``tl.dot_scaled`` kernel written for AMD gfx950, which lowers to the SM120
+block-scaled MMA: tokens are sorted by expert once, both GEMMs run as a single
+grouped launch over all experts, and activations are MXFP8-quantized on the fly.
+
+Unlike the gfx950 entry (SwiGLU-OAI only), this entry applies the standard
+gated SiLU on the split ``[gate | up]`` layout used by Qwen/DeepSeek-style MoE.
+Weights and scales stay in the canonical layout: ``w [E, N, K]`` fp8 e4m3 and
+``w_scale [E, N, K // 32]`` uint8 UE8M0.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+from sglang.jit_kernel.activation import silu_and_mul
+from sglang.srt.layers.moe.moe_runner.triton_utils.moe_align_block_size import (
+    moe_align_block_size,
+)
+from sglang.srt.layers.moe.moe_runner.triton_utils.mxfp8_moe_amd_gfx95 import (
+    _combine_topk_routes,
+    _grouped_gemm_mxfp8,
+)
+from sglang.srt.layers.quantization.mxfp8_amd_gfx95 import mxfp8_e4m3_quantize
+
+_BLOCK_M = 64
+
+
+def fused_experts_mxfp8_sm120(
+    hidden_states: torch.Tensor,
+    w1: torch.Tensor,
+    w2: torch.Tensor,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    w1_scale: torch.Tensor,
+    w2_scale: torch.Tensor,
+    *,
+    b1: Optional[torch.Tensor] = None,
+    b2: Optional[torch.Tensor] = None,
+    activation: str = "silu",
+    is_gated: bool = True,
+    no_combine: bool = False,
+    inplace: bool = False,
+    apply_router_weight_on_input: bool = False,
+    routed_scaling_factor: Optional[float] = None,
+    gemm1_alpha: Optional[float] = None,
+    gemm1_limit: Optional[float] = None,
+    swiglu_limit: Optional[float] = None,
+    expert_map: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    if not (activation == "silu" and is_gated):
+        raise NotImplementedError(
+            f"SM120 MXFP8 MoE only supports gated silu, got {activation=} {is_gated=}."
+        )
+    if b1 is not None or b2 is not None:
+        raise NotImplementedError("SM120 MXFP8 MoE does not support expert bias.")
+    if apply_router_weight_on_input:
+        raise NotImplementedError(
+            "SM120 MXFP8 MoE does not support apply_router_weight_on_input."
+        )
+    if gemm1_alpha is not None or gemm1_limit is not None or swiglu_limit is not None:
+        raise NotImplementedError(
+            "SM120 MXFP8 MoE does not support clamped / SwiGLU-OAI activations."
+        )
+
+    T, H = hidden_states.shape
+    top_k = topk_ids.shape[1]
+    M = T * top_k
+    local_num_experts = w1.shape[0]
+
+    if expert_map is not None:
+        valid_global = (topk_ids >= 0) & (topk_ids < expert_map.numel())
+        topk_ids = expert_map[topk_ids.clamp(0, expert_map.numel() - 1).long()].to(
+            torch.int32
+        )
+        topk_ids.masked_fill_(
+            ~valid_global | (topk_ids < 0) | (topk_ids >= local_num_experts), -1
+        )
+    else:
+        topk_ids = topk_ids.to(torch.int32, copy=True)
+        topk_ids.masked_fill_((topk_ids < 0) | (topk_ids >= local_num_experts), -1)
+
+    sorted_ids, expert_ids, num_post = moe_align_block_size(
+        topk_ids, _BLOCK_M, local_num_experts
+    )
+
+    # GEMM1: hidden states are quantized once; the kernel gathers rows per route.
+    a_q, a_s = mxfp8_e4m3_quantize(hidden_states)
+    gate_up = _grouped_gemm_mxfp8(
+        a_q,
+        a_s,
+        w1,
+        w1_scale,
+        sorted_ids,
+        expert_ids,
+        num_post,
+        M,
+        top_k,
+        _BLOCK_M,
+        hidden_states.dtype,
+        a_div=top_k,
+    )  # [M, 2I]
+
+    act = torch.empty(
+        (M, gate_up.shape[1] // 2), dtype=hidden_states.dtype, device=gate_up.device
+    )
+    silu_and_mul(gate_up, act)
+    act_q, act_s = mxfp8_e4m3_quantize(act)
+
+    if no_combine:
+        down = _grouped_gemm_mxfp8(
+            act_q,
+            act_s,
+            w2,
+            w2_scale,
+            sorted_ids,
+            expert_ids,
+            num_post,
+            M,
+            top_k,
+            _BLOCK_M,
+            hidden_states.dtype,
+            a_div=1,
+        )
+        return down.view(T, top_k, H)
+
+    # GEMM2 applies the top-k weight in the epilogue; routes are summed after.
+    down = _grouped_gemm_mxfp8(
+        act_q,
+        act_s,
+        w2,
+        w2_scale,
+        sorted_ids,
+        expert_ids,
+        num_post,
+        M,
+        top_k,
+        _BLOCK_M,
+        torch.float32,
+        a_div=1,
+        mul_weight_by=topk_weights.reshape(-1).to(torch.float32),
+    )  # [M, H]
+    out = _combine_topk_routes(down, T, top_k, H, hidden_states.dtype)
+
+    if routed_scaling_factor is not None and routed_scaling_factor != 1.0:
+        out.mul_(routed_scaling_factor)
+    if inplace:
+        hidden_states.copy_(out)
+        return hidden_states
+    return out
